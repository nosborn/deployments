FORGEJO____WORK_PATH=/data
FORGEJO__CACHE__ADAPTER=redis
# FORGEJO__CACHE__HOST=redis://forgejo-valkey:6379/0
FORGEJO__DATABASE__DB_TYPE=sqlite3
FORGEJO__DATABASE__SQLITE_JOURNAL_MODE=WAL
FORGEJO__INDEXER__ISSUE_INDEXER_TYPE=db
FORGEJO__METRICS__ENABLED=false
FORGEJO__OAUTH2__JWT_SECRET=***REMOVED***
