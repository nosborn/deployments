FORGEJO__REPOSITORY__ROOT=/data/git/forgejo-repositories
FORGEJO__SECURITY__INSTALL_LOCK=true
FORGEJO__SECURITY__INTERNAL_TOKEN=***REMOVED***
FORGEJO__SECURITY__SECRET_KEY=***REMOVED***
FORGEJO__SERVER__APP_DATA_PATH=/data
FORGEJO__SERVER__ENABLE_PPROF=false
FORGEJO__SERVER__HTTP_PORT=3000
FORGEJO__SERVER__LFS_JWT_SECRET=***REMOVED***
